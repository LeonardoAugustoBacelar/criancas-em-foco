# Copie este arquivo para .env e preencha os valores reais.

# Connection string do Postgres (Neon). Veja o README para o passo a passo.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Número de WhatsApp da equipe/clínica (DDI+DDD, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# URL pública do site (usada nos links de e-mail e no metadata de SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API key do Resend, usada para enviar o e-mail de redefinição de senha
RESEND_API_KEY=""

# E-mail remetente verificado no Resend (use onboarding@resend.dev até validar um domínio)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Gere com: openssl rand -base64 32
# Usado para proteger a rota /api/cron/booking-reminders (lembrete de aula do dia seguinte).
# Configure a mesma chave nas variáveis de ambiente do projeto na Vercel — o cron job
# configurado em vercel.json envia esse valor automaticamente no header Authorization.
CRON_SECRET=""
