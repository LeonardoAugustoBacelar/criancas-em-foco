// Prisma schema — Florescer Kids
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAE
  PROFESSORA
  ADMIN
}

enum BookingStatus {
  PENDENTE
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

enum BookingModality {
  ONLINE
  DOMICILIO_CASA_ALUNO
  DOMICILIO_CASA_PROFESSORA
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          Role     @default(MAE)
  createdAt     DateTime @default(now())

  teacherProfile TeacherProfile?
  bookingsAsMae  Booking[]        @relation("BookingsAsMae")
  resetTokens    PasswordResetToken[]
  reviews        Review[]         @relation("ReviewsAsMae")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeacherProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String
  specialties  String
  credentials  String?
  whatsapp     String
  photoUrl     String?
  videoCallLink String?
  pricePerHour Float    @default(0)
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Atendimento a domicílio (Cotia-SP e região) — opcional, além do online.
  offersDomicilio        Boolean @default(false)
  pricePerHourDomicilio  Float?
  // Endereço da professora, usado quando o aluno vai até a casa dela.
  // Só é revelado pra mãe depois que a aula é confirmada (mesmo padrão do
  // videoCallLink no atendimento online).
  domicilioAddress       String?

  availabilities Availability[]
  bookings       Booking[]       @relation("BookingsAsTeacher")
  reviews        Review[]
  blockedDates   BlockedDate[]
}

model BlockedDate {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime       @default(now())

  @@unique([teacherId, date])
}

model Availability {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
}

// Também existe um índice único parcial no banco (teacherId, date, startTime
// onde status IN (PENDENTE, CONFIRMADA)) — não representável aqui na sintaxe
// do Prisma, criado à mão na migração add_booking_slot_unique_index. É ele
// que garante, no banco, que duas reservas não fiquem com o mesmo horário
// mesmo em caso de corrida entre requisições simultâneas.
model Booking {
  id         String        @id @default(cuid())
  maeId      String
  mae        User          @relation("BookingsAsMae", fields: [maeId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    TeacherProfile @relation("BookingsAsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  childName  String
  date       DateTime
  startTime  String
  endTime    String
  notes      String?
  teacherNote String?
  status     BookingStatus @default(PENDENTE)
  modality   BookingModality @default(ONLINE)
  // Endereço do aluno, só usado quando modality = DOMICILIO_CASA_ALUNO (a
  // professora vai até a casa da família). Visível só pra essa mãe e pra
  // professora, nunca público.
  address    String?
  createdAt  DateTime      @default(now())

  review     Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  maeId     String
  mae       User     @relation("ReviewsAsMae", fields: [maeId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
